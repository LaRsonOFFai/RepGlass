{
  "name": "repglass",
  "version": "1.0.0",
  "author": "LaRsonOFFai",
  "description": "Private translucent live assistant with Codex OAuth and realtime transcription.",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:e2e": "npm run build && playwright test",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@openai/codex": "^0.144.0",
    "lucide-react": "^1.23.0",
    "openai": "^6.45.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.2.7",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ai.larsonoff.repglass",
    "productName": "RepGlass",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex*/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/logo.ico"
    },
    "nsis": {
      "artifactName": "RepGlass-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RepGlass",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "RepGlass-Portable-${version}-${arch}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
