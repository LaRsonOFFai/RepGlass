{
  "name": "repglass-workspace",
  "productName": "RepGlass",
  "version": "1.2.0",
  "private": true,
  "description": "Modern translucent live assistant powered by OpenAI Codex and Realtime transcription.",
  "scripts": {
    "setup": "npm run setup:win",
    "setup:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "setup:win:no-start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows.ps1 -NoStart",
    "dev": "npm --prefix app run dev",
    "start": "npm --prefix app run start",
    "start:hidden": "wscript Start-RepGlass-hidden.vbs",
    "shortcut:hidden": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-hidden-shortcut.ps1",
    "typecheck": "npm --prefix app run typecheck",
    "lint": "npm --prefix app run lint",
    "test": "npm --prefix app run test",
    "test:e2e": "npm --prefix app run test:e2e",
    "smoke:packaged": "npm --prefix app run smoke:packaged",
    "verify": "npm --prefix app run verify",
    "build": "npm --prefix app run build",
    "build:win": "npm --prefix app run dist",
    "audit:app": "npm --prefix app audit --omit=dev"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.12.1",
  "license": "GPL-3.0"
}
